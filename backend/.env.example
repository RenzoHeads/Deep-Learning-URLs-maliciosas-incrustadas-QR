# Copiar a .env y completar. Nunca commitear .env.

# URL de PostgreSQL (Neon en produccion)
DATABASE_URL=postgresql://usuario:password@host/dbname

# Origins CORS separados por coma (la app Android no lo necesita)
ALLOWED_ORIGINS=https://qr-guardian-api.vercel.app

# Auth0 — tenant y API (audience) para validar los JWT del cliente movil.
# DOMAIN sin esquema https:// (ej. dev-abc123.us.auth0.com).
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ALGORITMOS=RS256

# Rate limiting (ventana en segundos, limites por IP y clase de ruta)
RATE_LIMIT_VENTANA_SEGUNDOS=60
RATE_LIMIT_API=120

# Pool de conexiones asyncpg
POOL_MIN_SIZE=0
POOL_MAX_SIZE=20
